ARG PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE} AS api

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app

COPY api/requirements-dev.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements-dev.lock

RUN groupadd --gid 10001 voyaura \
    && useradd --uid 10001 --gid 10001 --no-create-home voyaura
COPY api/alembic.ini ./
COPY api/alembic ./alembic
COPY api/app ./app
USER voyaura

CMD ["python", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-proxy-headers"]

FROM api AS media-worker

USER root
RUN sed -i 's|http://deb.debian.org|https://deb.debian.org|g' /etc/apt/sources.list.d/debian.sources \
    && apt-get -o Acquire::Retries=2 update \
    && apt-get -o Acquire::Retries=2 install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
COPY api/scripts/media_pipeline_smoke.py ./scripts/
USER voyaura

CMD ["python", "-m", "app.media_worker"]
