ARG NODE_IMAGE=public.ecr.aws/docker/library/node:24-bookworm-slim
ARG NGINX_IMAGE=public.ecr.aws/docker/library/nginx:stable-alpine
FROM ${NODE_IMAGE} AS build

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/index.html web/tsconfig*.json web/vite.config.ts web/vitest.config.ts ./
COPY web/public ./public
COPY web/src ./src

ARG VITE_AMAP_KEY
ARG VITE_AMAP_SECURITY_CODE
ENV VITE_API_BASE_URL=/api/v1
RUN npm run build

FROM ${NGINX_IMAGE}
COPY infra/nginx/app.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
