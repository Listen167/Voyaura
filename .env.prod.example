# Copy to .env.prod on the server. Use openssl rand -hex 32 for each secret.
POSTGRES_PASSWORD=
VOYAURA_AUTH_TOKEN=

# Nginx inside Docker is published on the server loopback interface.
VOYAURA_WEB_PORT=8080
# The public HTTPS origin, if configured (for example https://travel.example.com).
VOYAURA_PUBLIC_ORIGIN=

# Browser-visible AMap JavaScript API settings. Set the domain in AMap and rebuild web.
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=
# API-only AMap Web Service and DeepSeek credentials.
VOYAURA_AMAP_WEB_KEY=
VOYAURA_AMAP_WEB_PRIVATE_KEY=
VOYAURA_DEEPSEEK_API_KEY=
VOYAURA_DEEPSEEK_MODEL=deepseek-chat
VOYAURA_AGENT_LLM_ENABLED=false
VOYAURA_AGENT_LLM_API_KEY=

# Required only with infra/compose.media.yml. The public endpoint must omit the scheme.
VOYAURA_MINIO_ENDPOINT=
VOYAURA_MINIO_ACCESS_KEY=
VOYAURA_MINIO_SECRET_KEY=
VOYAURA_MINIO_API_PORT=19000
